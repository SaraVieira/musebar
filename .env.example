# Required: generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET=

# Base URL the app is served from (used for cookies + OAuth callbacks)
BETTER_AUTH_URL=http://localhost:3000

# Port the container maps to on the host
PORT=3000

# Optional: enable GitHub OAuth. Leave empty to hide the "Continue with GitHub"
# button on the login page. If set, register an OAuth app at
# https://github.com/settings/developers with callback:
# ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Allow link/map metadata fetches to reach private, loopback and link-local
# addresses. Off by default. Only enable on a network you trust: with it on,
# any URL pasted into a board can probe the host's LAN from the server.
# ALLOW_PRIVATE_METADATA_FETCH=1
